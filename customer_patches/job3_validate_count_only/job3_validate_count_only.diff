+# =============================================================================
+# COUNT-ONLY PATCH (checksum_mode=off): validate each table with COUNT(*) only.
+#   * no Spark / no S3 CSV read, no column checks; DSQL COUNT(*) vs DMS FullLoadRows
+#     (or discovery's saved full_load_rows)
+#   * own small range code (does NOT reuse the validation range builders)
+#   * the 300s limit: a count that hits the limit OR fails with XX000 "server unavailable" is
+#     split into key ranges; a range that fails the same way is halved; counts are summed
+#   * ONE boundary list per table, built once: only the first range is open at the bottom and
+#     only the last is open at the top, so rows outside the sampled min/max are still counted
+#   * runtime checks on every run: boundaries strictly increasing, ranges == boundaries + 1,
+#     every counted piece joins the next with no gap/overlap. If a check fails the count is NOT
+#     used (table passed with a WARNING, nothing compared) - a wrong number is never reported
+#   * other errors: retried COUNT_RETRIES times, COUNT_RETRY_WAIT seconds apart; if the count
+#     still cannot finish the table passes with a WARNING and the run moves on to CDC.
+#   * HARD TIME LIMIT: the whole count for a table (expected-count lookup, key bounds, every range,
+#     retries) runs in a worker thread and the caller stops waiting after COUNT_TABLE_BUDGET_SECONDS
+#     (900 = 15 min) even if a query is still running; the table then passes with a WARNING.
+#     A count that FINISHES and DISAGREES fails the table.
+# =============================================================================
+COUNT_RETRIES = 3                  # retries per query for an error that is not a size problem
+COUNT_RETRY_WAIT = 20              # seconds between those retries
+COUNT_SPLIT_ROWS = 100_000_000     # expected rows at/above which we go straight to key ranges
+COUNT_RANGE_ROWS = 20_000_000      # target rows per range (about 40s at ~60s per 30M rows)
+COUNT_RANGE_THREADS = 4            # ranges counted at the same time
+COUNT_MAX_HALVINGS = 40            # how many times one range may be halved after size errors
+COUNT_UNKNOWN_TOTAL_ROWS = 600_000_000    # range sizing after a whole-table COUNT(*) was too big (or expected count unknown)
+COUNT_TABLE_BUDGET_SECONDS = 900   # HARD wall-clock limit per table (15 min): then warn + go on to CDC
+
+
+class CountRangeError(Exception):
+    """The count-only range math failed its own consistency check (never a data problem)."""
+
+
+class CountSplit(Exception):
+    """A query was too big for DSQL (300s limit / server unavailable): split it and retry."""
+
+
+class CountStop(Exception):
+    """Counting this table was stopped (time budget used up or another range failed)."""
+
+
+def _cnt_q(col):
+    return '"' + str(col).replace('"', '""') + '"'
+
+
+def _cnt_lit(kind, v):
+    if kind == "integer":
+        return str(int(v))
+    h = format(int(v), "032x")
+    return "'%s-%s-%s-%s-%s'::uuid" % (h[0:8], h[8:12], h[12:16], h[16:20], h[20:32])
+
+
+def _cnt_to_int(kind, v):
+    if kind == "integer":
+        return int(v)
+    return int(str(v).replace("-", "").strip().lower(), 16)
+
+
+def _cnt_pred(col, kind, lo, hi):
+    p = []
+    if lo is not None:
+        p.append("%s >= %s" % (_cnt_q(col), _cnt_lit(kind, lo)))
+    if hi is not None:
+        p.append("%s < %s" % (_cnt_q(col), _cnt_lit(kind, hi)))
+    # A range with no bounds still must not count NULL-key rows: those are counted separately.
+    return " AND ".join(p) if p else "%s IS NOT NULL" % _cnt_q(col)
+
+
+def _cnt_alive(ctx):
+    if ctx["abort"].is_set() or time.time() > ctx["deadline"]:
+        ctx["abort"].set()
+        raise CountStop("count-only stopped (time budget used up or another range failed)")
+
+
+def _cnt_unavailable(e):
+    """DSQL 'XX000 / server unavailable' - what a too-large scan can fail with instead of a timeout."""
+    s = ""
+    try:
+        a0 = e.args[0] if getattr(e, "args", None) else None
+        if isinstance(a0, dict):
+            if str(a0.get("C") or a0.get("code") or "") == "XX000":
+                return True
+            s = str(a0.get("M") or a0)
+        else:
+            s = str(a0 if a0 is not None else e)
+    except Exception:
+        s = str(e)
+    s = s.lower()
+    return "xx000" in s or "server unavailable" in s
+
+
+def _cnt_run(schema, table, pred, ctx):
+    """One COUNT(*). Too big (300s limit / statement timeout / XX000 after retries) -> CountSplit
+    so the caller splits it. Any other error is retried COUNT_RETRIES times, then raised."""
+    attempt = 0
+    while True:
+        _cnt_alive(ctx)
+        try:
+            return int(_target_query(schema, table, pred, [])[0])
+        except Exception as e:
+            if is_txn_age_error(e):
+                raise CountSplit(str(e)[:200])
+            attempt += 1
+            if attempt > COUNT_RETRIES:
+                if _cnt_unavailable(e):
+                    raise CountSplit(str(e)[:200])
+                raise
+            print("    count-only retry %d/%d on %s.%s after %s: %s"
+                  % (attempt, COUNT_RETRIES, schema, table, type(e).__name__, str(e)[:150]))
+            time.sleep(max(0.0, min(COUNT_RETRY_WAIT, ctx["deadline"] - time.time())))
+
+
+def _cnt_edge(schema, table, col, asc, ctx):
+    """Lowest (asc) or highest key, ignoring NULL keys (NULLs sort last on ASC, first on DESC)."""
+    sql = "SELECT %s FROM %s.%s WHERE %s IS NOT NULL ORDER BY %s %s LIMIT 1" % (
+        _cnt_q(col), schema, table, _cnt_q(col), _cnt_q(col), "ASC" if asc else "DESC")
+    attempt = 0
+    while True:
+        _cnt_alive(ctx)
+        conn = None
+        try:
+            conn = connect_dsql(autocommit=True)
+            cur = conn.cursor()
+            try:
+                cur.execute(sql)
+                r = cur.fetchone()
+            finally:
+                cur.close()
+            return None if (not r or r[0] is None) else r[0]
+        except Exception as e:
+            attempt += 1
+            if attempt > COUNT_RETRIES:
+                raise
+            print("    count-only retry %d/%d fetching key bounds on %s.%s after %s"
+                  % (attempt, COUNT_RETRIES, schema, table, type(e).__name__))
+            time.sleep(max(0.0, min(COUNT_RETRY_WAIT, ctx["deadline"] - time.time())))
+        finally:
+            try:
+                if conn is not None:
+                    conn.close()
+            except Exception:
+                pass
+
+
+def _cnt_nullable(schema, table, col):
+    """False only when information_schema says the column is NOT NULL (primary-key columns are).
+    Any doubt -> True (the NULL-key rows then get counted)."""
+    conn = None
+    try:
+        conn = connect_dsql(autocommit=True)
+        cur = conn.cursor()
+        try:
+            cur.execute("SELECT is_nullable FROM information_schema.columns "
+                        "WHERE table_schema = %s AND table_name = %s AND column_name = %s",
+                        (schema, table, col))
+            r = cur.fetchone()
+        finally:
+            cur.close()
+        return not (r and str(r[0]).strip().upper() == "NO")
+    except Exception:
+        return True
+    finally:
+        try:
+            if conn is not None:
+                conn.close()
+        except Exception:
+            pass
+
+
+def _cnt_plan(gmin, gmax, total, per):
+    """ONE boundary list for the whole table. Returns [(lo, hi, eff_lo, eff_hi), ...] where
+    lo/hi are the SQL bounds (None = open) and eff_lo/eff_hi are the finite bounds used only to
+    pick a split point. Only the first range has lo None and only the last has hi None."""
+    span = gmax - gmin + 1
+    n = max(1, -(-int(total) // max(1, int(per))))
+    n = min(n, span)
+    bounds = [gmin + (i * span) // n for i in range(1, n)]
+    prev = gmin
+    for bd in bounds:
+        if not (bd > prev and bd <= gmax):
+            raise CountRangeError("boundaries not strictly increasing inside (min, max]: %r" % (bounds[:5],))
+        prev = bd
+    edges = [None] + bounds + [None]
+    eff = [gmin] + bounds + [gmax + 1]
+    rngs = [(edges[i], edges[i + 1], eff[i], eff[i + 1]) for i in range(n)]
+    if len(rngs) != len(bounds) + 1:
+        raise CountRangeError("ranges (%d) != boundaries (%d) + 1" % (len(rngs), len(bounds)))
+    return rngs
+
+
+def _cnt_leaf(schema, table, col, kind, lo, hi, elo, ehi, depth, leaves, ctx):
+    """Count one range; on a size error halve it (children share the parent's outer bounds)."""
+    try:
+        n = _cnt_run(schema, table, _cnt_pred(col, kind, lo, hi), ctx)
+        leaves.append((elo, ehi, lo, hi, n))
+        return
+    except CountSplit as e:
+        too_big = e
+    if depth >= COUNT_MAX_HALVINGS or (ehi - elo) < 2:
+        raise too_big
+    mid = elo + (ehi - elo) // 2
+    if not (elo < mid < ehi):
+        raise CountRangeError("bad split point %r in [%r, %r)" % (mid, elo, ehi))
+    print("    count-only %s.%s: range too big, halving (depth %d)" % (schema, table, depth + 1))
+    _cnt_leaf(schema, table, col, kind, lo, mid, elo, mid, depth + 1, leaves, ctx)
+    _cnt_leaf(schema, table, col, kind, mid, hi, mid, ehi, depth + 1, leaves, ctx)
+
+
+def _cnt_verify(leaves, gmin, gmax):
+    """Every counted piece must join the next one exactly: no gap, no overlap, no repeat."""
+    if not leaves:
+        raise CountRangeError("no ranges were counted")
+    ls = sorted(leaves, key=lambda x: x[0])
+    if ls[0][0] != gmin or ls[0][2] is not None:
+        raise CountRangeError("first range is not open at the bottom / does not start at the minimum key")
+    if ls[-1][1] != gmax + 1 or ls[-1][3] is not None:
+        raise CountRangeError("last range is not open at the top / does not end past the maximum key")
+    for i, (elo, ehi, lo, hi, n) in enumerate(ls):
+        if not (elo < ehi):
+            raise CountRangeError("empty or inverted range [%r, %r)" % (elo, ehi))
+        if i > 0 and ls[i - 1][1] != elo:
+            raise CountRangeError("gap or overlap between ranges at %r (previous ends %r)" % (elo, ls[i - 1][1]))
+        if i > 0 and lo != elo:
+            raise CountRangeError("range %d lower bound %r differs from %r" % (i, lo, elo))
+        if i < len(ls) - 1 and hi != ehi:
+            raise CountRangeError("range %d upper bound %r differs from %r" % (i, hi, ehi))
+
+
+def _cnt_ranged(schema, table, col, kind, expected, ctx, after_timeout=False):
+    lo_raw = _cnt_edge(schema, table, col, True, ctx)
+    hi_raw = _cnt_edge(schema, table, col, False, ctx)
+    nulls = _cnt_run(schema, table, "%s IS NULL" % _cnt_q(col), ctx) \
+        if _cnt_nullable(schema, table, col) else 0
+    if lo_raw is None or hi_raw is None:
+        return nulls                                   # no non-NULL keys at all
+    gmin, gmax = _cnt_to_int(kind, lo_raw), _cnt_to_int(kind, hi_raw)
+    if gmax < gmin:
+        raise CountRangeError("maximum key %r is below minimum key %r" % (hi_raw, lo_raw))
+    # After a whole-table timeout the table is bigger than the expected count suggests (or the count
+    # was unknown): size the ranges for at least COUNT_UNKNOWN_TOTAL_ROWS so we do not start with one
+    # huge range that times out again and burns the time budget.
+    if after_timeout or not expected:
+        total = max(int(expected or 0), COUNT_UNKNOWN_TOTAL_ROWS)
+    else:
+        total = int(expected)
+    rngs = _cnt_plan(gmin, gmax, total, COUNT_RANGE_ROWS)
+    print("    count-only %s.%s: counting %d key range(s), %d at a time"
+          % (schema, table, len(rngs), COUNT_RANGE_THREADS))
+    per_range = [[] for _ in rngs]
+
+    def _one(i):
+        try:
+            _cnt_alive(ctx)
+            lo, hi, elo, ehi = rngs[i]
+            _cnt_leaf(schema, table, col, kind, lo, hi, elo, ehi, 0, per_range[i], ctx)
+        except BaseException:
+            ctx["abort"].set()          # stop the other ranges, do not let them run on
+            raise
+
+    errs = []
+    with ThreadPoolExecutor(max_workers=COUNT_RANGE_THREADS) as pool:
+        futs = [pool.submit(_one, i) for i in range(len(rngs))]
+        for f in futs:
+            try:
+                f.result()
+            except Exception as e:
+                errs.append(e)
+    if errs:
+        real = [e for e in errs if not isinstance(e, CountStop)]
+        raise (real or errs)[0]
+    leaves = [x for part in per_range for x in part]
+    _cnt_verify(leaves, gmin, gmax)
+    return sum(x[4] for x in leaves) + nulls
+
+
+def _cnt_impl(label, dsql_schema, dsql_table, entry, meta, pk_cols, pk_meta, rangeable, pk_col, pk_kind, ctx):
+    _e = entry if isinstance(entry, dict) else {}
+    expected, basis = None, None
+    if DMS_TASK_ARN:
+        try:
+            _fs = (meta.get('dms_schema') or _e.get('dms_schema') or meta.get('dms_folder_schema')
+                   or meta.get('source_schema') or dsql_schema)
+            _ft = (meta.get('dms_table') or _e.get('dms_table') or meta.get('dms_folder_table')
+                   or meta.get('source_table') or dsql_table)
+            expected = dms_full_load_rows_for(make_boto_client('dms'), DMS_TASK_ARN, _fs, _ft)
+            basis = "DMS FullLoadRows"
+        except Exception:
+            expected = None
+    if expected is None:
+        _v = _e.get('full_load_rows')
+        if _v is None:
+            _v = meta.get('full_load_rows')
+        if _v is not None:
+            expected, basis = int(_v), "discovery full_load_rows"
+    expected = int(expected) if expected is not None else None
+
+    # the column to split on: the validation key if it is rangeable, else a single-column key
+    # of a kind we can split (integer / uuid), whether or not the load kept it in the CSV
+    ck, kk = (pk_col, pk_kind) if rangeable else (None, None)
+    if ck is None and len(pk_cols or []) == 1 and (pk_meta or {}).get('pk_kind') in ("integer", "uuid"):
+        ck, kk = pk_cols[0], pk_meta.get('pk_kind')
+    can_range = bool(ck) and kk in ("integer", "uuid")
+
+    base = {"table": label, "ranges": 1, "checksum_mode": CHECKSUM_MODE, "columns_compared": 0,
+            "columns_differing": [], "mismatches": [], "mismatch_count": 0}
+    tgt, err = None, None
+    try:
+        if can_range and expected is not None and expected >= COUNT_SPLIT_ROWS:
+            # known big table (>= 100M rows expected): straight to key ranges, never a whole-table COUNT(*)
+            tgt = _cnt_ranged(dsql_schema, dsql_table, ck, kk, expected, ctx)
+        else:
+            try:
+                tgt = _cnt_run(dsql_schema, dsql_table, None, ctx)
+            except CountSplit:
+                if not can_range:
+                    raise
+                print("    count-only %s: whole-table COUNT(*) too big for DSQL; using key ranges" % label)
+                tgt = _cnt_ranged(dsql_schema, dsql_table, ck, kk, expected, ctx, after_timeout=True)
+    except CountRangeError as e:
+        msg = ("COUNT-ONLY RANGE CHECK FAILED (%s); the count was NOT used, table passed with a "
+               "WARNING, nothing compared" % e)
+        print("    ⚠️  count-only [%s]: %s" % (label, msg))
+        return dict(base, status="match", source_rows=expected, target_rows=None,
+                    warning=msg, notes=["COUNT-ONLY: " + msg])
+    except Exception as e:
+        err = e
+
+    if ctx.get("gave_up"):
+        return None                       # the caller already returned its own TIMED OUT warning
+    if isinstance(err, CountStop):
+        err = Exception("COUNT TIMED OUT after the %g-second per-table limit" % COUNT_TABLE_BUDGET_SECONDS)
+    if err is not None:
+        msg = ("COUNT NOT COMPLETED (%s: %s); table passed with a WARNING so the run can move on "
+               "to CDC" % (type(err).__name__, str(err)[:200]))
+        print("    ⚠️  count-only [%s]: %s" % (label, msg))
+        return dict(base, status="match", source_rows=expected, target_rows=None,
+                    warning=msg, notes=["COUNT-ONLY: " + msg])
+    if expected is None:
+        msg = "DSQL count %s; no DMS/discovery row count to compare against (not compared)" % format(tgt, ",")
+        print("    ⚠️  count-only [%s]: %s" % (label, msg))
+        return dict(base, status="match", source_rows=None, target_rows=tgt,
+                    warning=msg, notes=["COUNT-ONLY: " + msg])
+    tol = float(COUNT_MISMATCH_TOLERANCE or 0)
+    ok = abs(tgt - expected) <= tol
+    print("    count-only [%s]: DSQL=%s vs %s=%s -> %s"
+          % (label, format(tgt, ","), basis, format(expected, ","), "OK" if ok else "MISMATCH"))
+    mism = [] if ok else [{"range": ["whole table"], "type": "COUNT_DIFF",
+                           "source": expected, "target": tgt}]
+    return dict(base, status="match" if ok else "mismatch", source_rows=expected, target_rows=tgt,
+                mismatches=mism, mismatch_count=len(mism),
+                notes=["COUNT-ONLY: DSQL COUNT(*) vs %s" % basis])
+
+
+def count_only_validate(label, dsql_schema, dsql_table, entry, meta, pk_cols, pk_meta, rangeable, pk_col, pk_kind):
+    """Returns a result dict, or None when checksum_mode is not 'off' (normal validation runs).
+    Never raises: an unexpected problem inside this patch passes the table with a WARNING."""
+    if CHECKSUM_MODE != "off":
+        return None
+    ctx = {"abort": threading.Event(), "deadline": time.time() + COUNT_TABLE_BUDGET_SECONDS}
+    runner = ThreadPoolExecutor(max_workers=1)
+    try:
+        fut = runner.submit(_cnt_impl, label, dsql_schema, dsql_table, entry, meta, pk_cols, pk_meta,
+                            rangeable, pk_col, pk_kind, ctx)
+        try:
+            return fut.result(timeout=COUNT_TABLE_BUDGET_SECONDS)
+        except Exception as e:
+            import concurrent.futures as _cf
+            if not isinstance(e, _cf.TimeoutError):
+                raise
+            ctx["gave_up"] = True        # the abandoned worker thread must not log a second warning
+            ctx["abort"].set()           # background queries stop at their next step
+            msg = ("COUNT TIMED OUT after the %g-second per-table limit; table passed with a "
+                   "WARNING so the run can move on to CDC, nothing was compared" % COUNT_TABLE_BUDGET_SECONDS)
+            print("    ⚠️  count-only [%s]: %s" % (label, msg))
+            return {"table": label, "status": "match", "ranges": 1, "checksum_mode": CHECKSUM_MODE,
+                    "columns_compared": 0, "columns_differing": [], "mismatches": [], "mismatch_count": 0,
+                    "source_rows": None, "target_rows": None, "warning": msg, "notes": ["COUNT-ONLY: " + msg]}
+    except Exception as e:
+        msg = ("COUNT-ONLY INTERNAL ERROR (%s: %s); table passed with a WARNING, nothing was "
+               "compared" % (type(e).__name__, str(e)[:200]))
+        print("    ⚠️  count-only [%s]: %s" % (label, msg))
+        return {"table": label, "status": "match", "ranges": 1, "checksum_mode": CHECKSUM_MODE,
+                "columns_compared": 0, "columns_differing": [], "mismatches": [], "mismatch_count": 0,
+                "source_rows": None, "target_rows": None, "warning": msg,
+                "notes": ["COUNT-ONLY: " + msg]}
+    finally:
+        ctx["abort"].set()
+        runner.shutdown(wait=False)
+
+
