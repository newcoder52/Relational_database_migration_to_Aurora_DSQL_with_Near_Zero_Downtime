{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:<<REGION>>:<<ACCOUNT_ID>>:*"
      ]
    },
    {
      "Sid": "ReadSettingsTaskListsAndFolders",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<<BUCKET>>",
        "arn:aws:s3:::<<BUCKET>>/*"
      ]
    },
    {
      "Sid": "PublishPipelineSettingsFromParamsCsv",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<<BUCKET>>/config/pipeline.json",
        "arn:aws:s3:::<<BUCKET>>/config/pipeline.json.*"
      ]
    },
    {
      "Sid": "DescribeDmsTasksAndEndpoints",
      "Effect": "Allow",
      "Action": [
        "dms:DescribeReplicationTasks",
        "dms:DescribeEndpoints"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "SkipTasksAlreadyRunningList",
      "Effect": "Allow",
      "Action": [
        "states:ListExecutions"
      ],
      "Resource": [
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:stateMachine:<<PROJECT>>-startup",
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:stateMachine:<<PROJECT>>-cutover",
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:stateMachine:<<PROJECT>>-fleet-startup",
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:stateMachine:<<PROJECT>>-fleet-cutover"
      ]
    },
    {
      "Sid": "SkipTasksAlreadyRunningDescribe",
      "Effect": "Allow",
      "Action": [
        "states:DescribeExecution"
      ],
      "Resource": [
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:execution:<<PROJECT>>-startup:*",
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:execution:<<PROJECT>>-cutover:*"
      ]
    }
  ]
}
