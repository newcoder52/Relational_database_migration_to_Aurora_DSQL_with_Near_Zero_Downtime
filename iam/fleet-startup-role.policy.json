{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokePreflightLambda",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": ["arn:aws:lambda:<<REGION>>:<<ACCOUNT_ID>>:function:<<PROJECT>>-preflight-tasks"]
    },
    {
      "Sid": "StartAndVerifyChildStartups",
      "Effect": "Allow",
      "Action": ["states:StartExecution", "states:DescribeExecution"],
      "Resource": [
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:stateMachine:<<PROJECT>>-startup",
        "arn:aws:states:<<REGION>>:<<ACCOUNT_ID>>:execution:<<PROJECT>>-startup:*"
      ]
    }
  ]
}
