{
  "description": "Settings shared by every DMS task. Copy to s3://<bucket>/config/pipeline.json and replace every <...> (RUNBOOK Step 3c).",
  "project": "dms-dsql",
  "region": "<region, e.g. us-east-1>",
  "dsql_endpoint": "<cluster-id>.dsql.<region>.on.aws",
  "dsql_user": "admin",
  "dsql_database": "postgres",
  "glue_role_arn": "arn:aws:iam::<account-id>:role/dms-dsql-glue-exec-role",
  "glue_connection": "<exact Glue connection name, or empty string for no VPC>",
  "cdc_engine": "pythonshell",
  "cdc_spark_fallback": true,
  "control_schema": "cdc_control",
  "cdc_validation": true,
  "cdc_validation_sample": 20,
  "max_composite_forks": 8,
  "max_big_cdc_forks": 8,
  "big_table_row_threshold": 6000000,
  "file_fanout_threshold": 8,
  "max_groups": 10,
  "map_max_concurrency": 6,
  "max_files_in_parallel": 30,
  "conn_budget": 900,
  "min_writers_per_loader": 100,
  "max_writers_per_loader": 150
}
