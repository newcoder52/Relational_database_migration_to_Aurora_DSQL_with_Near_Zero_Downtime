{
  "Comment": "Per-task cutover: ONE per task (TASK_ARN hardcoded). Stop CDC -> drain -> stop this task's CDC run -> drop _cdc_file -> delete this task's Glue jobs.",
  "StartAt": "CutoverResolveTask",
  "States": {
    "CutoverResolveTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Derive cdc_root from the task's S3 target BucketFolder (matches startup) so drain-check scans the folder where DMS actually wrote CDC files.",
      "Parameters": {"FunctionName": "<<RESOLVE_TASK_LAMBDA_ARN>>", "Payload": {"taskArn": "<<TASK_ARN>>", "configPrefix": "<<CONFIG_PREFIX>>"}},
      "ResultSelector": {"cdcRoot.$": "$.Payload.cdcRoot"},
      "ResultPath": "$.resolved",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverFailed", "ResultPath": "$.error"}],
      "Next": "StopCdcDmsTask"
    },
    "StopCdcDmsTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:databasemigration:stopReplicationTask",
      "Parameters": {"ReplicationTaskArn": "<<TASK_ARN>>"},
      "ResultPath": "$.stopResult",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverFailed", "ResultPath": "$.error"}],
      "Next": "InitDmsStopCount"
    },
    "InitDmsStopCount": {"Type": "Pass", "Parameters": {"c": 0}, "ResultPath": "$.dmsStop", "Next": "WaitDmsStop"},
    "WaitDmsStop": {"Type": "Wait", "Seconds": 15, "Next": "DescribeCdcDmsTask"},
    "DescribeCdcDmsTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:databasemigration:describeReplicationTasks",
      "Parameters": {"Filters": [{"Name": "replication-task-arn", "Values": ["<<TASK_ARN>>"]}]},
      "ResultPath": "$.describeResult",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverFailed", "ResultPath": "$.error"}],
      "Next": "IsCdcTaskStopped"
    },
    "IsCdcTaskStopped": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.describeResult.ReplicationTasks[0].Status", "StringEquals": "stopped", "Next": "InitDrainCount"},
        {"Variable": "$.describeResult.ReplicationTasks[0].Status", "StringEquals": "failed", "Next": "CutoverFailed"}
      ],
      "Default": "IncrDmsStopCount"
    },
    "IncrDmsStopCount": {"Type": "Pass", "Parameters": {"c.$": "States.MathAdd($.dmsStop.c, 1)"}, "ResultPath": "$.dmsStop", "Next": "DmsStopBudgetLeft"},
    "DmsStopBudgetLeft": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.dmsStop.c", "NumericLessThan": 240, "Next": "WaitDmsStop"}],
      "Default": "CutoverFailed"
    },
    "InitDrainCount": {"Type": "Pass", "Parameters": {"c": 0}, "ResultPath": "$.drain", "Next": "DrainCheck"},
    "DrainCheck": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<DRAIN_CHECK_LAMBDA_ARN>>",
        "Payload": {
          "config_prefix": "<<CONFIG_PREFIX>>",
          "cdc_root.$": "$.resolved.cdcRoot",
          "dsql_endpoint": "<<DSQL_ENDPOINT>>",
          "dsql_user": "<<DSQL_USER>>",
          "dsql_database": "<<DSQL_DATABASE>>",
          "control_schema": "cdc_control"
        }
      },
      "ResultSelector": {"caughtUp.$": "$.Payload.caughtUp"},
      "ResultPath": "$.drainResult",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverFailed", "ResultPath": "$.error"}],
      "Next": "CdcCaughtUp"
    },
    "CdcCaughtUp": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.drainResult.caughtUp", "BooleanEquals": true, "Next": "StopCdcRun"}],
      "Default": "IncrDrainCount"
    },
    "IncrDrainCount": {"Type": "Pass", "Parameters": {"c.$": "States.MathAdd($.drain.c, 1)"}, "ResultPath": "$.drain", "Next": "DrainBudgetLeft"},
    "DrainBudgetLeft": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.drain.c", "NumericLessThan": 4320, "Next": "WaitDrain"}],
      "Default": "CdcDrainTimedOut"
    },
    "WaitDrain": {"Type": "Wait", "Seconds": 10, "Next": "DrainCheck"},
    "StopCdcRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<STOP_CDC_RUN_LAMBDA_ARN>>",
        "Payload": {"cdcJobName": "<<PROJECT>>-<<TASK_SUFFIX>>-cdc", "configPrefix": "<<CONFIG_PREFIX>>"}
      },
      "ResultPath": "$.stopRun",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverFailed", "ResultPath": "$.error"}],
      "Next": "DropTags"
    },
    "DropTags": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<DROP_TAGS_LAMBDA_ARN>>",
        "Payload": {
          "config_prefix": "<<CONFIG_PREFIX>>",
          "dsql_endpoint": "<<DSQL_ENDPOINT>>",
          "dsql_user": "<<DSQL_USER>>",
          "dsql_database": "<<DSQL_DATABASE>>",
          "drop_cdc_file_tag": true
        }
      },
      "ResultPath": "$.dropResult",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverFailed", "ResultPath": "$.error"}],
      "Next": "DeleteGlueJobs"
    },
    "DeleteGlueJobs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<CREATE_GLUE_JOBS_LAMBDA_ARN>>",
        "Payload": {"mode": "delete", "bucket": "<<BUCKET>>", "project": "<<PROJECT>>", "taskSuffix": "<<TASK_SUFFIX>>"}
      },
      "ResultPath": "$.deleteJobs",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 5, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "CutoverSucceeded", "ResultPath": "$.error"}],
      "Next": "CutoverSucceeded"
    },
    "CutoverSucceeded": {"Type": "Succeed"},
    "CutoverFailed": {"Type": "Fail", "Error": "CutoverFailed", "Cause": "A cutover step failed. See execution history."},
    "CdcDrainTimedOut": {"Type": "Fail", "Error": "CdcDrainBudgetExceeded", "Cause": "CDC did not catch up to the latest S3 CSV within the drain budget. Investigate, then re-run cutover."}
  }
}
