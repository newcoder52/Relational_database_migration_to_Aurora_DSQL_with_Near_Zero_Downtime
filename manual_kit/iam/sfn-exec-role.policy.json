{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeLambdas",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": ["arn:aws:lambda:<<REGION>>:<<ACCOUNT_ID>>:function:<<PROJECT>>-*"]
    },
    {
      "Sid": "DmsControl",
      "Effect": "Allow",
      "Action": ["dms:StartReplicationTask", "dms:StopReplicationTask",
                 "dms:DescribeReplicationTasks"],
      "Resource": ["*"]
    },
    {
      "Sid": "GlueRunJobs",
      "Effect": "Allow",
      "Action": ["glue:StartJobRun", "glue:GetJobRun", "glue:GetJobRuns",
                 "glue:BatchStopJobRun"],
      "Resource": ["*"]
    },
    {
      "Sid": "SyncJobRunEvents",
      "Effect": "Allow",
      "Action": ["events:PutTargets", "events:PutRule", "events:DescribeRule"],
      "Resource": ["arn:aws:events:<<REGION>>:<<ACCOUNT_ID>>:rule/StepFunctionsGetEventsForGlueJobRule"]
    }
  ]
}
