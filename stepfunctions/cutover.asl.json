{
  "Comment": "Shared cutover: ONE state machine for every DMS task. Start with {\"taskArn\": \"...\"}. Stop DMS -> drain CDC -> stop this task's CDC run -> drop _cdc_file -> delete this task's Glue jobs. The task's folder and job names are found by its ARN, so renaming the DMS task does not break cutover.",
  "StartAt": "CheckInput",
  "States": {
    "CheckInput": {
      "Type": "Choice",
      "Comment": "Start input must be {\"taskArn\": \"...\"}; everything else comes from config/pipeline.json and the DMS task.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.taskArn",
              "IsPresent": true
            },
            {
              "Variable": "$.taskArn",
              "IsString": true
            }
          ],
          "Next": "CutoverResolveTask"
        }
      ],
      "Default": "MissingTaskArn"
    },
    "MissingTaskArn": {
      "Type": "Fail",
      "Error": "MissingTaskArn",
      "Cause": "Start this workflow with input {\"taskArn\": \"arn:aws:dms:<region>:<account>:task:<id>\"}. Optional: \"taskSuffix\" (override the folder/job name), \"adoptExistingFolder\": true (startup only)."
    },
    "CutoverResolveTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Settings + this task's folder, CDC job name and cdc_root (resolve_task shared mode, read-only).",
      "Parameters": {
        "FunctionName": "<<RESOLVE_TASK_LAMBDA_ARN>>",
        "Payload": {
          "mode": "cutover",
          "bucket": "<<BUCKET>>",
          "settingsKey": "config/pipeline.json",
          "input.$": "$",
          "execution.$": "$$.Execution.Id",
          "stateMachine.$": "$$.StateMachine.Id"
        }
      },
      "ResultSelector": {
        "taskArnList.$": "$.Payload.taskArnList",
        "taskName.$": "$.Payload.taskName",
        "taskSuffix.$": "$.Payload.taskSuffix",
        "configPrefix.$": "$.Payload.configPrefix",
        "project.$": "$.Payload.project",
        "dsqlEndpoint.$": "$.Payload.dsqlEndpoint",
        "dsqlUser.$": "$.Payload.dsqlUser",
        "dsqlDatabase.$": "$.Payload.dsqlDatabase",
        "controlSchema.$": "$.Payload.controlSchema",
        "cdcJobName.$": "$.Payload.cdcJobName",
        "cdcRoot.$": "$.Payload.cdcRoot",
        "warnings.$": "$.Payload.warnings"
      },
      "ResultPath": "$.resolved",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ResolveFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "StopCdcDmsTask"
    },
    "ResolveFailed": {
      "Type": "Fail",
      "Comment": "Shows the resolve-task error (bad settings, DMS task check, folder owner check).",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    },
    "StopCdcDmsTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:databasemigration:stopReplicationTask",
      "Parameters": {
        "ReplicationTaskArn.$": "$.taskArn"
      },
      "ResultPath": "$.stopResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CutoverFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "InitDmsStopCount"
    },
    "InitDmsStopCount": {
      "Type": "Pass",
      "Parameters": {
        "c": 0
      },
      "ResultPath": "$.dmsStop",
      "Next": "WaitDmsStop"
    },
    "WaitDmsStop": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "DescribeCdcDmsTask"
    },
    "DescribeCdcDmsTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:databasemigration:describeReplicationTasks",
      "Parameters": {
        "Filters": [
          {
            "Name": "replication-task-arn",
            "Values.$": "$.resolved.taskArnList"
          }
        ]
      },
      "ResultPath": "$.describeResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CutoverFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "IsCdcTaskStopped"
    },
    "IsCdcTaskStopped": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.describeResult.ReplicationTasks[0].Status",
          "StringEquals": "stopped",
          "Next": "InitDrainCount"
        },
        {
          "Variable": "$.describeResult.ReplicationTasks[0].Status",
          "StringEquals": "failed",
          "Next": "CutoverFailed"
        }
      ],
      "Default": "IncrDmsStopCount"
    },
    "IncrDmsStopCount": {
      "Type": "Pass",
      "Parameters": {
        "c.$": "States.MathAdd($.dmsStop.c, 1)"
      },
      "ResultPath": "$.dmsStop",
      "Next": "DmsStopBudgetLeft"
    },
    "DmsStopBudgetLeft": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.dmsStop.c",
          "NumericLessThan": 240,
          "Next": "WaitDmsStop"
        }
      ],
      "Default": "CutoverFailed"
    },
    "InitDrainCount": {
      "Type": "Pass",
      "Parameters": {
        "c": 0
      },
      "ResultPath": "$.drain",
      "Next": "DrainCheck"
    },
    "DrainCheck": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<DRAIN_CHECK_LAMBDA_ARN>>",
        "Payload": {
          "config_prefix.$": "$.resolved.configPrefix",
          "cdc_root.$": "$.resolved.cdcRoot",
          "dsql_endpoint.$": "$.resolved.dsqlEndpoint",
          "dsql_user.$": "$.resolved.dsqlUser",
          "dsql_database.$": "$.resolved.dsqlDatabase",
          "control_schema.$": "$.resolved.controlSchema"
        }
      },
      "ResultSelector": {
        "caughtUp.$": "$.Payload.caughtUp"
      },
      "ResultPath": "$.drainResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CutoverFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "CdcCaughtUp"
    },
    "CdcCaughtUp": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.drainResult.caughtUp",
          "BooleanEquals": true,
          "Next": "StopCdcRun"
        }
      ],
      "Default": "IncrDrainCount"
    },
    "IncrDrainCount": {
      "Type": "Pass",
      "Parameters": {
        "c.$": "States.MathAdd($.drain.c, 1)"
      },
      "ResultPath": "$.drain",
      "Next": "DrainBudgetLeft"
    },
    "DrainBudgetLeft": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.drain.c",
          "NumericLessThan": 4320,
          "Next": "WaitDrain"
        }
      ],
      "Default": "CdcDrainTimedOut"
    },
    "WaitDrain": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "DrainCheck"
    },
    "StopCdcRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<STOP_CDC_RUN_LAMBDA_ARN>>",
        "Payload": {
          "cdcJobName.$": "$.resolved.cdcJobName",
          "configPrefix.$": "$.resolved.configPrefix"
        }
      },
      "ResultPath": "$.stopRun",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CutoverFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "DropTags"
    },
    "DropTags": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<DROP_TAGS_LAMBDA_ARN>>",
        "Payload": {
          "config_prefix.$": "$.resolved.configPrefix",
          "dsql_endpoint.$": "$.resolved.dsqlEndpoint",
          "dsql_user.$": "$.resolved.dsqlUser",
          "dsql_database.$": "$.resolved.dsqlDatabase",
          "drop_cdc_file_tag": true
        }
      },
      "ResultPath": "$.dropResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "CutoverFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "DeleteGlueJobs"
    },
    "DeleteGlueJobs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "<<CREATE_GLUE_JOBS_LAMBDA_ARN>>",
        "Payload": {
          "mode": "delete",
          "bucket": "<<BUCKET>>",
          "project.$": "$.resolved.project",
          "taskSuffix.$": "$.resolved.taskSuffix"
        }
      },
      "ResultPath": "$.deleteJobs",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "GlueJobsNotDeleted",
          "ResultPath": "$.error"
        }
      ],
      "Next": "AllGlueJobsDeleted",
      "Comment": "Deletes this task's 5 Glue jobs. A job already gone counts as deleted; any other failure ends at GlueJobsNotDeleted instead of reporting success."
    },
    "AllGlueJobsDeleted": {
      "Type": "Choice",
      "Comment": "create-glue-jobs lists jobs it could not delete under 'failed' (older versions return no such list).",
      "Choices": [
        {
          "Variable": "$.deleteJobs.Payload.failed[0]",
          "IsPresent": true,
          "Next": "GlueJobsNotDeletedList"
        }
      ],
      "Default": "CutoverSucceeded"
    },
    "GlueJobsNotDeletedList": {
      "Type": "Pass",
      "Parameters": {
        "Error": "GlueJobsNotDeleted",
        "Cause.$": "States.JsonToString($.deleteJobs.Payload.failed)"
      },
      "ResultPath": "$.error",
      "Next": "GlueJobsNotDeleted"
    },
    "GlueJobsNotDeleted": {
      "Type": "Fail",
      "Comment": "The migration itself is cut over: DMS is stopped, every CDC file was applied, the CDC job is stopped and the _cdc_file column is dropped. Only deleting the task's Glue jobs failed; the cause names them. Delete them by hand (aws glue delete-job --job-name <name>), or start the cutover again.",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    },
    "CutoverSucceeded": {
      "Type": "Succeed"
    },
    "CutoverFailed": {
      "Type": "Fail",
      "Error": "CutoverFailed",
      "Cause": "A cutover step failed. See execution history."
    },
    "CdcDrainTimedOut": {
      "Type": "Fail",
      "Error": "CdcDrainBudgetExceeded",
      "Cause": "CDC did not catch up to the latest S3 CSV within the drain budget. Investigate, then re-run cutover."
    }
  }
}
