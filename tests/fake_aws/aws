#!/usr/bin/env python3
"""Fake `aws` CLI for offline tests of tools/setup.sh (existing-roles / manage_iam work).

It logs EVERY invocation (one JSON object per line) to $FAKE_AWS_LOG, then prints a canned
response good enough for setup.sh to proceed. Behaviour is steered entirely by environment
variables so a test can model "role missing", "wrong trust", "simulate denied", etc. without
touching AWS.

Env knobs (all optional):
  FAKE_AWS_LOG            path to the newline-delimited JSON call log (required in practice)
  FAKE_MISSING_ROLES     space/comma list of role NAMES for which `iam get-role` exits non-zero
  FAKE_TRUST_<ROLE>      the service principal that role's trust allows (e.g. glue.amazonaws.com).
                         ROLE is the role name upper-cased with non-alphanumerics -> '_'. If unset
                         for a role, a sensible default is inferred from the role name
                         (…glue…->glue, …lambda…->lambda, …sfn…/…states…->states). Set to the
                         literal string "NONE" to model a role that trusts nothing we need.
  FAKE_SIM_DENY          space/comma list of action names simulate-principal-policy reports as
                         "implicitDeny" (for ALL roles). Empty = everything allowed.
  FAKE_SIM_CALL_DENY     space/comma list of role NAMES for which the simulate CALL ITSELF errors
                         (non-zero exit, stderr) — models "not authorized to call iam:Simulate*".
  FAKE_LEGACY_SMS        space/comma list of state-machine names list-state-machines returns.
  FAKE_GLUE_JOBS         space/comma list of Glue job names list-jobs returns.
  FAKE_GLUE_TAGGED       space/comma list of those job names that HAVE the dsql_pipeline_project
                         tag (others are reported as untagged legacy).
Everything is read-only to the test; the fake never mutates anything.
"""
import json
import os
import sys


def _list(envname):
    raw = os.environ.get(envname, "") or ""
    return [x for x in raw.replace(",", " ").split() if x]


def log_call(argv):
    path = os.environ.get("FAKE_AWS_LOG")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps({"argv": argv}) + "\n")


def get_opt(argv, name):
    """Return the value following --name, or None."""
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return None


def role_env_key(role):
    safe = "".join(c if c.isalnum() else "_" for c in role).upper()
    return "FAKE_TRUST_" + safe


def inferred_principal(role):
    r = role.lower()
    if "glue" in r:
        return "glue.amazonaws.com"
    if "lambda" in r:
        return "lambda.amazonaws.com"
    if "sfn" in r or "states" in r or "step" in r:
        return "states.amazonaws.com"
    return "glue.amazonaws.com"


def main():
    argv = sys.argv[1:]
    log_call(argv)
    if not argv:
        return 0
    service = argv[0]
    op = argv[1] if len(argv) > 1 else ""

    if service == "iam":
        return iam(op, argv)
    if service == "stepfunctions":
        return stepfunctions(op, argv)
    if service == "glue":
        return glue(op, argv)
    if service == "lambda":
        return lambda_(op, argv)
    if service == "s3":
        if op == "ls":
            return 1
        if op == "cp":
            src = argv[2] if len(argv) > 2 else ""
            if src.startswith("s3://"):
                return 1
            return 0
        return 0
    if service == "ec2":
        if op == "describe-subnets":
            print("us-east-1a")
            return 0
        return 0
    return 0


def iam(op, argv):
    if op == "get-role":
        role = get_opt(argv, "--role-name") or ""
        if role in _list("FAKE_MISSING_ROLES"):
            sys.stderr.write("An error occurred (NoSuchEntity): role %s not found\n" % role)
            return 254
        q = get_opt(argv, "--query") or ""
        principal = os.environ.get(role_env_key(role))
        if principal is None:
            principal = inferred_principal(role)
        if principal == "NONE":
            doc = {"Version": "2012-10-17", "Statement": []}
        else:
            doc = {"Version": "2012-10-17", "Statement": [{
                "Effect": "Allow",
                "Principal": {"Service": principal},
                "Action": "sts:AssumeRole",
            }]}
        if "AssumeRolePolicyDocument" in q:
            print(json.dumps(doc))
        else:
            print(json.dumps({"Role": {"RoleName": role, "Arn":
                              "arn:aws:iam::111122223333:role/" + role,
                              "AssumeRolePolicyDocument": doc}}))
        return 0
    if op == "simulate-principal-policy":
        src = get_opt(argv, "--policy-source-arn") or ""
        role = src.rsplit("/", 1)[-1]
        if role in _list("FAKE_SIM_CALL_DENY"):
            sys.stderr.write("An error occurred (AccessDenied): not authorized to perform: "
                             "iam:SimulatePrincipalPolicy\n")
            return 254
        actions = []
        if "--action-names" in argv:
            i = argv.index("--action-names") + 1
            while i < len(argv) and not argv[i].startswith("--"):
                actions.append(argv[i])
                i += 1
        deny = set(_list("FAKE_SIM_DENY"))
        rows = [[a, "implicitDeny"] for a in actions if a in deny]
        out = get_opt(argv, "--output") or "json"
        if out == "text":
            print("\n".join("\t".join(r) for r in rows))
        else:
            print(json.dumps(rows))
        return 0
    if op in ("list-role-policies", "list-attached-role-policies"):
        print(json.dumps({"PolicyNames": [], "AttachedPolicies": []}))
        return 0
    return 0


def stepfunctions(op, argv):
    if op == "list-state-machines":
        q = get_opt(argv, "--query") or ""
        legacy = _list("FAKE_LEGACY_SMS")
        if "name==" in q:
            import re
            m = re.search(r"name=='([^']+)'", q)
            nm = m.group(1) if m else ""
            if nm in legacy:
                print("arn:aws:states:us-east-1:111122223333:stateMachine:" + nm)
            else:
                print("")
            return 0
        if "starts_with" in q:
            print("\n".join(legacy))
            return 0
        print("")
        return 0
    if op == "list-executions":
        print("0")
        return 0
    return 0


def glue(op, argv):
    if op == "list-jobs":
        print(json.dumps({"JobNames": _list("FAKE_GLUE_JOBS")}))
        return 0
    if op == "get-job":
        print(json.dumps({"Job": {"DefaultArguments": {}}}))
        return 0
    if op == "get-tags":
        arn = get_opt(argv, "--resource-arn") or ""
        name = arn.rsplit("/", 1)[-1]
        tagged = _list("FAKE_GLUE_TAGGED")
        tags = {"dsql_pipeline_project": "yes"} if name in tagged else {}
        q = get_opt(argv, "--query") or ""
        if "Tags" in q:
            print(json.dumps(tags))
        else:
            print(json.dumps({"Tags": tags}))
        return 0
    if op == "get-connection":
        return 1
    return 0


def lambda_(op, argv):
    if op == "get-function":
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
