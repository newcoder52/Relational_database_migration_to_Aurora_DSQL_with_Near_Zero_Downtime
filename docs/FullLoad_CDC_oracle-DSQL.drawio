        <mxCell id="f_map" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9F1;strokeColor=#CD2264;fontSize=10;fontColor=#232F3E;verticalAlign=middle;align=center;" value="FanOut Map (5 at a time)&#10;start shared startup / cutover&#10;execution per task (async)&#10;skip already-running / past-full-load">
