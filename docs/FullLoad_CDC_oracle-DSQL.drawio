          <mxGeometry height="196" width="1540" x="80" y="76" as="geometry" />
        </mxCell>
        <mxCell id="f_input" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=10;fontColor=#232F3E;verticalAlign=middle;align=center;" value="Start by hand&#10;{&quot;bucket&quot;, &quot;inputPrefix&quot;}&#10;(optional tasksFile,&#10;default fleet_tasks.csv)">
