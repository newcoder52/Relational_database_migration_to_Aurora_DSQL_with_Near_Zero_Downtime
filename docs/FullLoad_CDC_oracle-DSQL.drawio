        </mxCell>
        <mxCell id="s5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9F1;strokeColor=#CD2264;fontSize=10;fontColor=#232F3E;verticalAlign=middle;" value="5. create-glue-jobs (Lambda, mode create)">
