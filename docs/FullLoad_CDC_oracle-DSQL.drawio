          <mxGeometry height="16" width="480" x="945" y="520" as="geometry" />
        </mxCell>
        <mxCell id="gvpc" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1BA9C9;dashed=1;fontSize=9;fontStyle=2;fontColor=#1BA9C9;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" value="Glue VPC (Glue connection; no internet / no PyPI) — drivers come from S3; optional DMS/CloudWatch calls use short 5 s/15 s timeouts">
          <mxGeometry height="320" width="660" x="940" y="546" as="geometry" />
        </mxCell>
        <mxCell id="g_disc" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" value="Job 1: discovery">
          <mxGeometry height="38" width="38" x="975" y="576" as="geometry" />
        </mxCell>
        <mxCell id="g_disc_t" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontColor=#5A6B86;" value="finds each table's DMS folder (any letter case, BucketFolder honoured; fails loudly if none) → target schema + PK/type metadata → mapping + master index">
          <mxGeometry height="40" width="560" x="1025" y="575" as="geometry" />
        </mxCell>
        <mxCell id="g_load" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" value="Job 2: load / load-big">
          <mxGeometry height="38" width="38" x="975" y="648" as="geometry" />
        </mxCell>
        <mxCell id="g_load_t" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontColor=#5A6B86;" value="per-file parallel (250MB ×30); DSQL txn limits; UUID + timestamptz">
          <mxGeometry height="38" width="560" x="1025" y="648" as="geometry" />
        </mxCell>
        <mxCell id="g_val" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" value="Job 3: validate">
          <mxGeometry height="38" width="38" x="975" y="720" as="geometry" />
        </mxCell>
        <mxCell id="g_val_t" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontColor=#5A6B86;" value="per-range row count + per-column content summaries for every column by DSQL type (incl. binary/bytea); checksum_mode=aggregate default (off/md5 optional) → _validation_report.json">
          <mxGeometry height="48" width="560" x="1025" y="715" as="geometry" />
        </mxCell>
        <mxCell id="g_cdc" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" value="CDC: continuous">
          <mxGeometry height="38" width="38" x="975" y="800" as="geometry" />
        </mxCell>
        <mxCell id="g_cdc_t" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontColor=#5A6B86;" value="long-running; Python shell by default, automatic Spark fallback (same job name) if the Python-shell drivers fail; applies I/U/D; crash-proof resume via cdc_control; single-column-PK tables only — multi-column-PK tables need the separate composite-key CDC job (customer-supplied), which must mark files done in cdc_file_status">
          <mxGeometry height="64" width="560" x="1025" y="796" as="geometry" />
        </mxCell>
        <mxCell id="g_cdc_mck" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;dashed=1;fontSize=8;fontColor=#5B2FA6;verticalAlign=middle;align=center;" value="composite-key CDC job&#10;(customer-supplied)&#10;→ cdc_file_status">
          <mxGeometry height="54" width="150" x="975" y="862" as="geometry" />
        </mxCell>

        <mxCell id="g_load_val" parent="1" edge="1" source="g_load" target="g_val" style="endArrow=block;strokeColor=#8C4FFF;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="667" /><mxPoint x="960" y="739" /></Array></mxGeometry></mxCell>

        <!-- invoke arrows: startup Lambda -->
        <mxCell id="inv_l1" parent="1" edge="1" source="s1" target="l_resolve" style="dashed=1;strokeColor=#ED7100;endArrow=open;fontSize=8;fontColor=#B85C00;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="invoke"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="411" /><mxPoint x="900" y="375" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_l2" parent="1" edge="1" source="s2" target="l_driver" style="dashed=1;strokeColor=#ED7100;endArrow=open;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="invoke"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="470" /><mxPoint x="880" y="340" /><mxPoint x="1129" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_l3" parent="1" edge="1" source="s5" target="l_create" style="dashed=1;strokeColor=#ED7100;endArrow=open;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="invoke"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1309" y="613" /><mxPoint x="1309" y="394" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_l4" parent="1" edge="1" source="s7" target="l_plan" style="dashed=1;strokeColor=#ED7100;endArrow=open;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="invoke"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1499" y="689" /><mxPoint x="1499" y="394" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_fb" parent="1" edge="1" source="s_fb" target="l_create" style="dashed=1;strokeColor=#ED7100;endArrow=open;fontSize=8;fontColor=#B85C00;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="cdc_fallback"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="944" /><mxPoint x="1340" y="400" /></Array></mxGeometry></mxCell>

        <!-- invoke arrows: fleet preflight -->
        <mxCell id="inv_pre" parent="1" edge="1" source="f_pre" target="l_pre" style="dashed=1;strokeColor=#ED7100;endArrow=open;fontSize=8;fontColor=#B85C00;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="invoke"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="270" /><mxPoint x="969" y="270" /></Array></mxGeometry></mxCell>

        <!-- startJobRun arrows -->
        <mxCell id="inv_g6" parent="1" edge="1" source="s6" target="g_disc" style="dashed=1;strokeColor=#8C4FFF;endArrow=open;fontSize=8;fontColor=#5B2FA6;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="startJobRun.sync"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="651" /><mxPoint x="930" y="595" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_g8" parent="1" edge="1" source="s8" target="g_load" style="dashed=1;strokeColor=#8C4FFF;endArrow=open;fontSize=8;fontColor=#5B2FA6;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="startJobRun.sync"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="740" /><mxPoint x="910" y="667" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_g10" parent="1" edge="1" source="s10" target="g_cdc" style="dashed=1;strokeColor=#8C4FFF;endArrow=open;fontSize=8;fontColor=#5B2FA6;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="startJobRun.async"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="829" /><mxPoint x="900" y="819" /></Array></mxGeometry></mxCell>
        <mxCell id="inv_g11" parent="1" edge="1" source="s11" target="g_cdc" style="dashed=1;strokeColor=#8C4FFF;endArrow=open;fontSize=8;fontColor=#5B2FA6;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="getJobRun"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="878" /><mxPoint x="890" y="825" /></Array></mxGeometry></mxCell>

        <!-- data arrows from Glue -->
        <mxCell id="e_g_s3" parent="1" edge="1" source="g_disc" target="s3" style="dashed=1;strokeColor=#7AA116;endArrow=open;fontSize=8;fontColor=#4A6410;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" value="read CSV / write mappings"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="595" /></Array></mxGeometry></mxCell>
        <mxCell id="e_cdc_s3" parent="1" edge="1" source="g_cdc" target="s3" style="dashed=1;strokeColor=#7AA116;endArrow=open;fontSize=8;fontColor=#4A6410;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;" value="poll CDC files; copy applied file&#10;→ &amp;lt;table&amp;gt;/processed/ (+ _manifest.json);&#10;originals kept"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="1150" /><mxPoint x="305" y="1150" /><mxPoint x="305" y="719" /></Array></mxGeometry></mxCell>
        <mxCell id="e_cdc_dsql" parent="1" edge="1" source="g_cdc" target="dsql" style="dashed=1;strokeColor=#C925D1;endArrow=open;fontSize=8;fontColor=#8A1B90;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=bottom;" value="apply I/U/D + checkpoint&#10;(cdc_control)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1170" /><mxPoint x="190" y="1170" /><mxPoint x="190" y="1039" /></Array></mxGeometry></mxCell>

        <!-- ===================== CUTOVER STATE MACHINE (bottom band) ===================== -->
        <mxCell id="cut" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B8860B;dashed=1;fontSize=11;fontStyle=1;fontColor=#7A5B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" value="AWS Step Functions — cutover (one shared state machine, start with {&quot;taskArn&quot;}; irreversible). Stop writes on the source first.">
          <mxGeometry height="110" width="1540" x="80" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="c0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B8860B;fontSize=9;fontColor=#232F3E;verticalAlign=middle;align=center;" value="CheckInput → resolve-task&#10;(else MissingTaskArn / ResolveFailed)">
          <mxGeometry height="46" width="200" x="100" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FF;strokeColor=#527FFF;fontSize=9;fontColor=#232F3E;verticalAlign=middle;align=center;" value="1. Stop DMS task&#10;wait until stopped&#10;(15 s × 240 = 60 min)">
          <mxGeometry height="46" width="190" x="320" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#ED7100;fontSize=9;fontColor=#232F3E;verticalAlign=middle;align=center;" value="2. drain-check loop until every&#10;CDC file is marked done&#10;(10 s × 4320 = 12 h, else&#10;CdcDrainTimedOut)">
          <mxGeometry height="46" width="220" x="530" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#ED7100;fontSize=9;fontColor=#232F3E;verticalAlign=middle;align=center;" value="3. stop-cdc-run">
          <mxGeometry height="46" width="130" x="770" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#ED7100;fontSize=9;fontColor=#232F3E;verticalAlign=middle;align=center;" value="4. drop-tags&#10;(_cdc_file)">
          <mxGeometry height="46" width="130" x="920" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9F1;strokeColor=#CD2264;fontSize=9;fontColor=#232F3E;verticalAlign=middle;align=center;" value="5. delete the task's 5 Glue jobs&#10;create-glue-jobs (mode delete)">
          <mxGeometry height="46" width="210" x="1070" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3DD;strokeColor=#3F8624;fontSize=9;fontStyle=1;fontColor=#232F3E;verticalAlign=middle;align=center;" value="CutoverSucceeded&#10;(else GlueJobsNotDeleted =&#10;cut over, delete jobs by hand).&#10;Then repoint app to Aurora DSQL.">
          <mxGeometry height="46" width="300" x="1300" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="ce1" parent="1" edge="1" source="c0" target="c1" style="endArrow=block;strokeColor=#B8860B;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" parent="1" edge="1" source="c1" target="c2" style="endArrow=block;strokeColor=#B8860B;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" parent="1" edge="1" source="c2" target="c3" style="endArrow=block;strokeColor=#B8860B;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" parent="1" edge="1" source="c3" target="c4" style="endArrow=block;strokeColor=#B8860B;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" parent="1" edge="1" source="c4" target="c5" style="endArrow=block;strokeColor=#B8860B;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce6" parent="1" edge="1" source="c5" target="c6" style="endArrow=block;strokeColor=#3F8624;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== FAILURE-STATE LEGEND ===================== -->
        <mxCell id="fail" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;dashed=0;fontSize=9;fontColor=#7A1C12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Failure / stop states&#10;• before DMS starts (DMS NOT started): MissingTaskArn, ResolveFailed, DriversFailed&#10;• during full load: DmsFailed, DmsTimedOut (24 h), GroupLoadOrValidateFailed, PipelineFailed&#10;• after full load — DMS IS capturing changes: CdcRunFailed, CdcFallbackFailed, CdcRunEnded, CdcStartNotConfirmed&#10;• cutover: MissingTaskArn, ResolveFailed, CutoverFailed, CdcDrainTimedOut, GlueJobsNotDeleted&#10;• fleet: MissingFleetInput, PreflightFailed, FleetStartIncomplete, FleetFailed">
          <mxGeometry height="110" width="760" x="80" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#5A6B86;" value="Solid = data plane (Source → DMS → S3 → Glue writes/applies to Aurora DSQL).  Dashed = control plane: Step Functions hold only states; their Task states invoke Lambda and, via startJobRun, Glue — both run outside the state machine. Blue states add the CDC phase; the continuous CDC job applies ongoing changes until cutover.&#10;&#10;Unblock a table: UPDATE cdc_control.cdc_status SET status='active' — never delete the row.&#10;Cutover is irreversible per task; stop source writes before starting it.">
          <mxGeometry height="110" width="760" x="860" y="1360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
